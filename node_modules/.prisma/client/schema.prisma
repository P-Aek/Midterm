generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cartItems {
  cart_item_id Int      @id @default(autoincrement())
  cart_id      Int
  product_id   Int
  quantity     Int
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         carts    @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  product      products @relation(fields: [product_id], references: [product_id])

  @@index([cart_id], map: "CartItems_cart_id_fkey")
  @@index([product_id], map: "CartItems_product_id_fkey")
}

model carts {
  cart_id   Int         @id @default(autoincrement())
  user_id   Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     cartItems[]
  user      users       @relation(fields: [user_id], references: [user_id])

  @@index([user_id], map: "Carts_user_id_fkey")
}

model orderitems {
  order_item_id Int      @id @default(autoincrement())
  order_id      Int
  product_id    Int
  product_name  String
  quantity      Int
  price         Float
  Total_price   Float
  order         orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  product       products @relation(fields: [product_id], references: [product_id])

  @@index([order_id], map: "OrderItems_order_id_fkey")
  @@index([product_id], map: "OrderItems_product_id_fkey")
}

model orders {
  order_id     Int            @id @default(autoincrement())
  user_id      Int
  order_date   DateTime       @default(now())
  order_status String         @default("pending")
  items        orderitems[]
  user         users          @relation(fields: [user_id], references: [user_id])
  transaction  transactions[]

  @@index([user_id], map: "Orders_user_id_fkey")
}

model products {
  product_id   Int          @id @default(autoincrement())
  product_name String
  description  String
  price        Float
  quantity     Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cartItems    cartItems[]
  orderItems   orderitems[]
}

model users {
  user_id   Int      @id @default(autoincrement())
  email     String   @unique(map: "Users_email_key")
  password  String
  name      String?
  address   String?
  createdAt DateTime @default(now())
  roles     String   @default("user")
  carts     carts[]
  orders    orders[]
  otp       otp[]
}

model otp {
  otp_id    Int      @id @default(autoincrement())
  user_id   Int
  otp       String
  expiresAt DateTime
  user      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "Otp_user_id_fkey")
}

model transactions {
  transaction_id   Int      @id @default(autoincrement())
  order_id         Int
  payment_method   String
  amount           Float
  status           String
  transaction_date DateTime @default(now())
  order            orders   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id], map: "transaction_order_id_fkey")
  @@index([payment_method], map: "transaction_payment_method_fkey")
}
